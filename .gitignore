# ===========================================================================
# EXCLUSION ZONE — Never commit under any circumstances
# ===========================================================================
WORKSPACE_TREE.txt
generate_workspace_tree.py

# Archived / superseded working documents (consolidated into docs/TECHNICAL_REVIEW.md)
archive/
technical_review_report.md
AUDIT_ISSUES.md
AMR_Project_Analysis.md

# Standalone presentation generator (not part of the pipeline)
amr_sunum.js

# ============================================================================
# GENERATED OUTPUTS (reproducible from the pipeline — not version-controlled)
# ============================================================================
# Plots, CSVs, logs and run artifacts are regenerated by running the scripts.
# Kept out of git to keep the repository lean; they remain on disk locally.
results/
logs/

