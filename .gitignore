optuna_studies/

# ============================================================================
# MLOps RUN ARTIFACTS (generated run metadata / metrics)
# ============================================================================
runs/**
# No !runs/.gitkeep exception: runs/ is a symlink to scratch on the HPC, and a
# tracked file under it makes `git reset --hard` replace the symlink with a real
# directory (see the data/ note above). The pipeline mkdir -p's runs/ anyway.

